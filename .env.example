APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ASR_API_KEYS=current-key,previous-key
ASR_STREAM_TOKEN_SECRET=replace-with-a-long-random-secret
MODEL_ENCODER=/models/streaming-paraformer-zh-en/encoder.int8.onnx
MODEL_DECODER=/models/streaming-paraformer-zh-en/decoder.int8.onnx
MODEL_TOKENS=/models/streaming-paraformer-zh-en/tokens.txt
OFFLINE_MODEL=/models/sherpa-onnx-paraformer-trilingual-zh-cantonese-en/model.onnx
OFFLINE_MODEL_TOKENS=/models/sherpa-onnx-paraformer-trilingual-zh-cantonese-en/tokens.txt
SHERPA_PROVIDER=cpu
SHERPA_NUM_THREADS=4
SHERPA_DECODING_METHOD=greedy_search
MAX_UPLOAD_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=300
MAX_CONCURRENT_UPLOADS=2
UPLOAD_TIMEOUT_SECONDS=90
STREAM_MAX_CONNECTIONS=20
STREAM_MAX_BATCH_SIZE=8
STREAM_MAX_WAIT_MS=8
STREAM_BUFFER_SECONDS=5
STREAM_IDLE_TIMEOUT_SECONDS=30
STREAM_MAX_DURATION_SECONDS=3600
STREAM_MAX_MESSAGE_BYTES=1048576
ENDPOINT_RULE1_MIN_TRAILING_SILENCE=2.4
ENDPOINT_RULE2_MIN_TRAILING_SILENCE=1.2
ENDPOINT_RULE3_MIN_UTTERANCE_LENGTH=20
ENABLE_METRICS=true
ENABLE_API_DOCS=false
LOG_TRANSCRIPTION_TEXT=false
SHUTDOWN_GRACE_SECONDS=30
